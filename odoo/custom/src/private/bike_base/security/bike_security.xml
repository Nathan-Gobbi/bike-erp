<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_bike_erp" model="ir.module.category">
        <field name="name">Bike ERP</field>
        <field name="description">Access rights for the Bike ERP application.</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_bike_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_bike_erp" />
        <field
            name="implied_ids"
            eval="[
            (4, ref('sales_team.group_sale_salesman')),
            (4, ref('stock.group_stock_user')),
            (4, ref('account.group_account_invoice')),
        ]"
        />
        <field
            name="comment"
        >Operational access: sales, stock and billing (create invoices, register payments). No access to accounting configuration or financial reports.</field>
    </record>

    <record id="group_bike_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_bike_erp" />
        <field
            name="implied_ids"
            eval="[
            (4, ref('group_bike_user')),
            (4, ref('sales_team.group_sale_manager')),
            (4, ref('stock.group_stock_manager')),
            (4, ref('account.group_account_manager')),
        ]"
        />
        <field
            name="comment"
        >Full access to Bike ERP: sales, stock, billing/accounting management, reports and configuration.</field>
    </record>
</odoo>
