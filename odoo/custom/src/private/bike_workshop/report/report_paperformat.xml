<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        80mm continuous thermal roll. page_height is set much larger than any
        real receipt so the content never breaks into a second printed page;
        wkhtmltopdf/the printer driver crops to the actual content height.
    -->
    <record id="paperformat_bike_receipt" model="report.paperformat">
        <field name="name">Bike ERP - Comprovante Térmico 80mm</field>
        <field name="default" eval="False" />
        <field name="format">custom</field>
        <field name="page_height">1000</field>
        <field name="page_width">80</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">3</field>
        <field name="margin_bottom">3</field>
        <field name="margin_left">2</field>
        <field name="margin_right">2</field>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
</odoo>
